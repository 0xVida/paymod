DATABASE_URL=postgresql://paymod:paymod@localhost:5432/paymod?schema=public
REDIS_URL=redis://localhost:6379
PAYMOD_BOOTSTRAP_TOKEN=
PAYMOD_EXECUTOR_SECRET=
PAYMOD_RELAYER_SECRET=
PAYMOD_EXECUTOR_PUBLIC_KEY=
# Circle Developer-Controlled Wallets - the active wallet rail. See
# apps/api/circle.md for the full runbook (scripts included) instead of
# doing any of this by hand.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENTITY_PUBLIC_KEY_FILE=./circle-entity-public-key.pem
CIRCLE_WALLET_SET_ID=
# One of the CircleBlockchain values in packages/circle/src/client.ts, e.g. BASE-SEPOLIA for testnet.
CIRCLE_BLOCKCHAIN=BASE-SEPOLIA
# Circle's id for the USDC contract on CIRCLE_BLOCKCHAIN specifically, not a
# universal "Circle USDC" id - every chain has its own USDC contract and its
# own token id. Re-derive this (circle.md explains how) any time
# CIRCLE_BLOCKCHAIN changes, not just once ever.
CIRCLE_USDC_TOKEN_ID=
# The real on-chain USDC contract on CIRCLE_BLOCKCHAIN - different from
# CIRCLE_USDC_TOKEN_ID above (Circle's own internal id for the same token).
# Needed for x402 requirement matching and EIP-712 signing. Source:
# https://developers.circle.com/stablecoins/usdc-contract-addresses
CIRCLE_USDC_CONTRACT_ADDRESS=
# Read-only RPC endpoint for CIRCLE_BLOCKCHAIN, used only to reconcile a
# stuck x402 payment's on-chain authorization state. Optional - falls back
# to a public endpoint per chain if unset (circle-config.ts).
CIRCLE_RPC_URL=

# Stellar - dormant, kept for a future multi-chain expansion. Not wired
# into any live wallet-creation or settlement path today.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_USDC_CONTRACT_ID=
PAYMOD_TREASURY_WASM_HASH=
PAYMOD_TELEGRAM_BOT_TOKEN=
PAYMOD_TELEGRAM_BOT_USERNAME=
PAYMOD_TELEGRAM_WEBHOOK_SECRET=
PAYMOD_TELEGRAM_CALLBACK_SECRET=
WEB_ORIGIN=http://localhost:3000
PORT=3001

# AES-256-GCM master key (32 bytes, base64) for every secret Paymod Code
# stores at rest: a CodeDepositAddress's Solana keypair and a
# ProviderApiKey's real provider key (apps/api/src/common/secret-encryption.ts).
CODE_DEPOSIT_KEY_ENCRYPTION_KEY=

# Comma-separated User ids allowed to sign in to /v1/admin/* (provider-key
# and model-pricing administration - apps/api/src/common/admin.guard.ts).
# No email fallback - always the stable id.
ADMIN_USER_IDS=

# Paymod-managed inference no longer reads a static OPENAI_API_KEY/
# ANTHROPIC_API_KEY - real provider keys are admin-managed and encrypted
# at rest (POST /v1/admin/provider-keys). Not needed for BYOK either way -
# only the inference proxy reads them.

# Paymod Code balance deposits (PAYMOD_CODE_PLAN.md section 2) - Solana.
# solana-config.ts fails closed in production if any of these four are
# unset - it never silently falls back to devnet with real users. Local
# dev defaults to devnet (below); production needs all four overridden
# with real mainnet values before real USDC deposits will be credited.
#
# Mainnet USDC mint (Circle's official mint, verified against
# circle.com/blog and multiple independent sources - this value is public,
# safe to commit, not a secret):
#   SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#
# SOLANA_RPC_URL in production needs a paid provider (Helius/QuickNode/
# Alchemy) - the public endpoint below is devnet-only and too rate-limited
# for real deposit-sweep traffic on mainnet.
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RPC_URL_2: optional backup RPC endpoint. Every call transparently
# retries against this one if the primary rejects (see withFailover in
# solana-config.ts) - a provider going down or rate-limiting no longer
# means deposit checks and sweeps just fail. Not required.
SOLANA_RPC_URL_2=
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Required to enable the opportunistic sweep after a credited deposit
# (apps/api/src/code/sweep.service.ts) - a deposit still credits correctly
# with neither configured, but funds then sit at the per-account deposit
# address instead of reaching the treasury.
#
# SOLANA_TREASURY_ADDRESS: the real mainnet wallet every swept USDC
# deposit ends up in. Must be a wallet you control - never generated or
# filled in by anyone else.
SOLANA_TREASURY_ADDRESS=
# SOLANA_RELAYER_SECRET_KEY: pays only the SOL network fee for each sweep
# transaction - by design it can never move USDC, only its own SOL
# balance (see getRelayerKeypair's doc comment in solana-config.ts). Needs
# a small real SOL balance to actually pay for sweeps once set. base58 -
# the same format Phantom/Solflare export and the Solana CLI keypair
# files use, no conversion needed.
SOLANA_RELAYER_SECRET_KEY=
# SOLANA_RPC_API_KEY: optional. Some RPC providers (Tatum, among others)
# gate real methods like getSignaturesForAddress behind an API key sent
# as an x-api-key header - without it, a real deposit check fails with
# "not available for anonymous access". Not needed for a provider that
# embeds its key in the URL instead (Helius, QuickNode) or the public
# devnet default.
SOLANA_RPC_API_KEY=
