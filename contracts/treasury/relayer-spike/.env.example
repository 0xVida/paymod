# Disposable Testnet secrets only. Never use production credentials here.
PAYMOD_EXECUTOR_SECRET=S...
PAYMOD_RELAYER_SECRET=S...
# Alternatively, provide paths to one-secret files instead. This avoids placing
# test secrets in environment dumps or shell history.
# PAYMOD_EXECUTOR_SECRET_FILE=/absolute/path/to/executor-secret
# PAYMOD_RELAYER_SECRET_FILE=/absolute/path/to/relayer-secret

# Deployed disposable Testnet Treasury Contract.
TREASURY_CONTRACT_ID=CCQBVEGLHCXPJUDRP7D5XLHSDG34L5PFYUAJWDTK3FYGHUDY7OWJV4GD

# Recipient must be able to receive Testnet USDC.
RECIPIENT=G...

# Atomic USDC amount. Example: 1000000 = 0.1 USDC at 7 decimals.
AMOUNT=1000000

# Exactly 32 bytes, hex encoded. Generate a fresh value for every run.
PAYMENT_ID_HEX=...
